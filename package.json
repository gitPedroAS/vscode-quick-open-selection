{
  "name": "quick-open-selection",
  "description": "Open Quick Open pre-filled with the current selection — search text in files (%) or by filename",
  "author": "Pedro Santos",
  "license": "MIT",
  "version": "0.1.0",
  "publisher": "gitPedroAS",
  "preview": true,
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [],
  "activationEvents": [
    "onCommand:quickOpenSelection.searchText",
    "onCommand:quickOpenSelection.searchFile"
  ],
  "extensionKind": [
    "ui"
  ],
  "homepage": "https://github.com/gitPedroAS/vscode-quick-open-selection",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitPedroAS/vscode-quick-open-selection.git"
  },
  "bugs": {
    "url": "https://github.com/gitPedroAS/vscode-quick-open-selection/issues"
  },
  "main": "./out/src/extension",
  "contributes": {
    "commands": [
      {
        "title": "Quick Open: Search selected text in files (%)",
        "category": "Search",
        "command": "quickOpenSelection.searchText"
      },
      {
        "title": "Quick Open: Search selected text as filename",
        "category": "Search",
        "command": "quickOpenSelection.searchFile"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.73.0",
    "typescript": "^4.9.0"
  }
}
