{
  "name": "quick-open-and-search-enhancements",
  "displayName": "Quick Open & Search Enhancements",
  "description": "Enhance VS Code Quick Open: search selected text, search in a chosen directory, toggle symlink following",
  "author": "Pedro Santos",
  "license": "MIT",
  "version": "0.3.0",
  "publisher": "gitPedroAS",
  "preview": true,
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [],
  "activationEvents": [
    "onCommand:quickOpenSE.searchText",
    "onCommand:quickOpenSE.searchFile",
    "onCommand:quickOpenSE.toggleSymlinks",
    "onCommand:quickOpenSE.searchInDirectory",
    "onCommand:quickOpenSE.dirPickerRight"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "homepage": "https://github.com/gitPedroAS/vscode-quick-open-and-search-enhancements",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitPedroAS/vscode-quick-open-and-search-enhancements.git"
  },
  "bugs": {
    "url": "https://github.com/gitPedroAS/vscode-quick-open-and-search-enhancements/issues"
  },
  "main": "./out/src/extension",
  "contributes": {
    "commands": [
      {
        "title": "Search selected text in files (%)",
        "category": "Quick Open",
        "command": "quickOpenSE.searchText"
      },
      {
        "title": "Search selected text as filename",
        "category": "Quick Open",
        "command": "quickOpenSE.searchFile"
      },
      {
        "title": "Toggle symlink inclusion in search",
        "category": "Quick Open",
        "command": "quickOpenSE.toggleSymlinks"
      },
      {
        "title": "Search in directory",
        "category": "Quick Open",
        "command": "quickOpenSE.searchInDirectory"
      }
    ],
    "keybindings": [
      {
        "key": "right",
        "command": "quickOpenSE.dirPickerRight",
        "when": "inQuickOpen && quickOpenSE.dirPickerOpen"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.73.0",
    "typescript": "^4.9.0"
  }
}
